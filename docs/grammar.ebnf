(* Etude grammar
 *
 * Notation:
 *   rule = ... ;      definition
 *   "x"               literal token
 *   'x'               literal token (used for `"` and `\`)
 *   a b               sequence
 *   a | b             alternative
 *   [ a ]             optional
 *   { a }             zero or more
 *   ( a )             grouping
 *   (* ... *)         comment
 *
 * Status: describes the planned language. Not implemented yet:
 *   - global `let`, which is still undecided: only `def` is accepted at
 *     the top level for now.
 *)


(* ===================================================================== *)
(* Program                                                               *)
(* ===================================================================== *)

(* A program is a list of global definitions. Running it initializes the
 * globals in order, then calls `main()`.
 *
 * `let` and `def` differ in when code runs:
 *   - `let` evaluates its right-hand side eagerly, once, at that point in
 *     the program. Use it for values.
 *   - `def` evaluates nothing when defined; its body runs on every call.
 *     Use it for functions, including ones with side effects:
 *     `def f() = ...` delays the effects until `f()` is called.
 *
 * Visibility:
 *   - builtins (`print`, `println`, `int_to_str`) are globals too; a
 *     top-level definition may not reuse their names, but locals may
 *     shadow them;
 *   - every `def` can see every other top-level definition, in any order,
 *     so recursion and mutual recursion need no extra syntax. This is safe
 *     because a `def` is always a function and needs no evaluation;
 *   - a global `let` initializer runs in order and may use earlier globals
 *     and call any function. Reading a global that has not been
 *     initialized yet is a runtime error.
 *)
program     = { item } EOF ;

item        = global_let
            | def ;

global_let  = "let" IDENT "=" expr ";" ;

(* Always a function, always with a parameter list: there is no
 * `def x = expr` form. `def f(a, b) = body;` means `f = fun(a, b) => body`,
 * with `f` in scope inside its own body. Only allowed at the top level
 * for now.
 *
 * The bare name `f` is the function as a value; `f(...)` calls it.
 *
 * Functions take a list of parameters and are not curried:
 * `def add(a, b)` has type `(int, int) -> int` and must be called as
 * `add(1, 2)`. Currying is written out: `def add(a) = fun(b) => a + b;` has
 * type `int -> int -> int`, called as `add(1)(2)`. *)
def         = "def" IDENT "(" [ params ] ")" "=" expr ";" ;

(* A trailing comma is allowed in parameter and argument lists. *)
params      = IDENT { "," IDENT } [ "," ] ;


(* ===================================================================== *)
(* Expressions, from lowest to highest precedence                        *)
(* ===================================================================== *)

expr        = or_expr ;

or_expr     = and_expr { "||" and_expr } ;

and_expr    = comparison { "&&" comparison } ;

(* Non-associative: `a < b < c` is a syntax error.
 * `==` and `!=` work on two integers, booleans, strings or units; functions
 * cannot be compared. `<`, `<=`, `>`, `>=` work on integers only. *)
comparison  = additive [ compare_op additive ] ;

compare_op  = "==" | "!=" | "<" | "<=" | ">" | ">=" ;

additive    = multiplicative { ( "+" | "-" ) multiplicative } ;

multiplicative
            = unary { ( "*" | "/" ) unary } ;

unary       = ( "-" | "!" ) unary
            | postfix ;

(* Calls bind tighter than any operator: `f(x)(y)`, `make_adder(1)(2)`.
 * The number of arguments must match the number of parameters exactly;
 * there is no implicit partial application. *)
postfix     = atom { call_args } ;

call_args   = "(" [ expr { "," expr } [ "," ] ] ")" ;

atom        = INT
            | STRING
            | "true"
            | "false"
            | IDENT
            | "(" ")"                       (* unit *)
            | "(" expr ")"
            | block
            | if_expr
            | lambda ;

(* An anonymous function. It closes over the variables in scope where it
 * is written. `=>` (not `=` as in `def`) separates parameters from body,
 * which keeps `let f = fun(x) => x == 0;` readable.
 *
 * The body extends as far right as possible: `fun(x) => x + 1` is
 * `fun(x) => (x + 1)`, and `fun(f) => f(1)` calls `f` inside the body. It
 * stops at `,` `)` `;` `}`, so `g(fun(x) => x, 2)` passes two arguments.
 * To call a lambda right away, put it in parentheses:
 * `(fun(x) => x + 1)(41)`. *)
lambda      = "fun" "(" [ params ] ")" "=>" expr ;


(* ===================================================================== *)
(* Blocks and statements                                                 *)
(* ===================================================================== *)

(* A block's value is its tail expression, which is required: there is no
 * implicit unit, so a block run only for its effects ends in an explicit
 * `()`, as in `{ f(); () }`. Each `let` is in scope for the rest of the
 * block, so `{ let x = e1; rest }` means `let x = e1 in { rest }`.
 *
 * Parsing note: after an expression, ";" makes it a statement and "}"
 * makes it the tail. *)
block       = "{" { stmt } expr "}" ;

(* Bindings are immutable; a later `let` with the same name shadows the
 * earlier one. `let` is not recursive: in `let x = x + 1;` the right-hand
 * `x` is the outer one.
 * Every statement ends in ";", including ones that end in a block. *)
stmt        = "let" IDENT "=" expr ";"
            | expr ";" ;                    (* evaluated for side effects *)

(* Braces are required, so there is no dangling-else ambiguity.
 * Without `else`, the value is unit. *)
if_expr     = "if" expr block [ "else" ( block | if_expr ) ] ;


(* ===================================================================== *)
(* Lexical grammar                                                       *)
(* ===================================================================== *)

(* Whitespace and comments separate tokens and are otherwise ignored.
 * Whitespace is ASCII only: space, tab, newline, carriage return and form
 * feed. Other Unicode spaces, such as U+00A0, are not allowed. *)
whitespace  = " " | "\t" | "\n" | "\r" | "\f" ;

comment     = "//" { ? any character except newline ? } ;

(* A keyword is never an identifier. *)
IDENT       = ( letter | "_" ) { letter | digit | "_" } ;

keyword     = "let" | "def" | "fun" | "if" | "else" | "true" | "false" ;

(* Must fit in an i64; a larger literal is an error. Negative numbers are
 * unary minus applied to a literal. Letters and `_` directly after the
 * digits are part of the same token, so `123abc` and `1_000` are each one
 * malformed literal (an error), not a number followed by an identifier.
 * Leading zeros are allowed: `007` is 7. *)
INT         = digit { digit } ;

(* Written between double quotes on a single line: a newline before the
 * closing `"` is an error ("unterminated string literal"). Inside, `\`
 * starts an escape:
 *
 *   \n  newline           \r  carriage return    \t  tab
 *   \\  backslash         \"  double quote       \0  NUL
 *
 * Any other escape is an error, e.g. `\q`, `\1`, `\x41` or `\u{41}`; write
 * `\\` for a literal backslash. Strings can be compared with `==` and `!=`;
 * there is no concatenation or ordering yet. *)
STRING      = '"' { string_char | escape } '"' ;

string_char = ? any character except '"', '\' and newline ? ;

escape      = '\' ( "n" | "r" | "t" | '\' | '"' | "0" ) ;

letter      = "a" | ... | "z" | "A" | ... | "Z" ;

digit       = "0" | ... | "9" ;

(* Longest match: "==" before "=", "=>" before "=", "<=" before "<", etc. *)
punctuation = "+" | "-" | "*" | "/" | "!"
            | "=" | "==" | "!=" | "<" | "<=" | ">" | ">="
            | "&&" | "||" | "=>"
            | "(" | ")" | "{" | "}" | "," | ";" ;

(* Not a character in the source: the lexer returns it once the input
 * runs out, and keeps returning it. *)
EOF         = ? end of input ? ;
